# Lockin : modele de configuration.
#
# Usage : cp .env.example .env, puis renseigner les valeurs.
# Le fichier .env n'est jamais versionne ni copie dans l'image Docker.
# Il est exclu par .gitignore et par .dockerignore, les deux sont testes.

# --- Modele -----------------------------------------------------------------

# Cle API Anthropic. Se genere sur https://console.anthropic.com/settings/keys
# Ne jamais la coller ailleurs que dans .env : ni dans un message, ni dans un
# commit, ni dans le journal. Le bareme du hackathon retire 10 points par
# occurrence, et une cle exposee doit etre revoquee, pas seulement effacee.
ANTHROPIC_API_KEY=sk-ant-api03-REMPLACER_PAR_VOTRE_CLE

# Identifiant exact du modele. Pas de suffixe de date : l'API resout
# claude-haiku-4-5 vers sa version courante, verifie le 07/09/2026.
# Haiku 4.5 : contexte 200K, 1,00 $ par million de tokens en entree,
# 5,00 $ par million en sortie.
LOCKIN_MODEL=claude-haiku-4-5

# --- Stockage ---------------------------------------------------------------

# Chemin de la base SQLite qui porte le journal, les constats et l'etat des
# missions. Doit rester sous /app/data : c'est le point de montage du volume
# declare dans compose.yaml. Ecrire ailleurs ferait disparaitre le journal a
# chaque redemarrage du conteneur, et la reconstruction d'etat n'aurait plus
# de support.
LOCKIN_DB_PATH=/app/data/lockin.db

# --- Recherche web ----------------------------------------------------------
# A COMPLETER : le fournisseur de recherche n'est pas encore arrete.
# Ces lignes sont volontairement commentees plutot qu'inventees, pour qu'un
# lancement echoue clairement au lieu de lire une variable fantome.
#
# SEARCH_PROVIDER=
# SEARCH_API_KEY=

# --- Reseau -----------------------------------------------------------------
# A CONFIRMER avec le backend : port d'ecoute reel du serveur.
# Le Dockerfile expose 8000 et compose.yaml publie 127.0.0.1:8000.
# HOST=0.0.0.0
# PORT=8000
